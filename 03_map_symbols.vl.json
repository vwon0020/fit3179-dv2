{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "description": "Map 3 - Proportional symbol map: circle area = mobile phone subscriptions (World Bank/ITU); colour = which brand group has the biggest share of phones in that country (StatCounter).",
 "width": 980,
 "height": 470,
 "projection": {
  "type": "equalEarth"
 },
 "params": [
  {
   "name": "group",
   "value": "All brand groups",
   "bind": {
    "input": "select",
    "name": "Highlight countries led by: ",
    "options": [
     "All brand groups",
     "Apple",
     "Samsung",
     "Chinese brands",
     "Transsion (Tecno, Infinix, itel)"
    ]
   }
  }
 ],
 "layer": [
  {
   "data": {
    "sphere": true
   },
   "mark": {
    "type": "geoshape",
    "fill": "#f2f4f5",
    "stroke": "#cfd8de",
    "strokeWidth": 0.6
   }
  },
  {
   "data": {
    "url": "data/countries-110m.json",
    "format": {
     "type": "topojson",
     "feature": "countries"
    }
   },
   "transform": [
    {
     "filter": "datum.id !== '010'"
    }
   ],
   "mark": {
    "type": "geoshape",
    "fill": "#e4e0d6",
    "stroke": "#ffffff",
    "strokeWidth": 0.5
   }
  },
  {
   "data": {
    "url": "data/world_phones.json"
   },
   "transform": [
    {
     "filter": "isValid(datum.lon) && isValid(datum.subs) && datum.subs > 0"
    },
    {
     "calculate": "datum.subs / 1e6",
     "as": "subsM"
    }
   ],
   "mark": {
    "type": "circle",
    "stroke": "#ffffff",
    "strokeWidth": 0.8
   },
   "encoding": {
    "longitude": {
     "field": "lon",
     "type": "quantitative"
    },
    "latitude": {
     "field": "lat",
     "type": "quantitative"
    },
    "size": {
     "field": "subsM",
     "type": "quantitative",
     "title": "Mobile subscriptions (millions)",
     "scale": {
      "range": [
       6,
       2600
      ]
     },
     "legend": {
      "values": [
       10,
       100,
       500,
       1500
      ],
      "orient": "bottom-left",
      "symbolFillColor": "#ffffff",
      "symbolStrokeColor": "#5b6470",
      "direction": "vertical"
     }
    },
    "color": {
     "field": "bigGroup",
     "type": "nominal",
     "title": "Biggest brand group",
     "scale": {
      "domain": [
       "Apple",
       "Samsung",
       "Chinese brands",
       "Transsion (Tecno, Infinix, itel)"
      ],
      "range": [
       "#2f3237",
       "#1f4fd1",
       "#ff6a13",
       "#0f9d9a"
      ]
     },
     "legend": {
      "orient": "bottom-right",
      "symbolType": "circle"
     }
    },
    "opacity": {
     "condition": {
      "test": "group === 'All brand groups' || datum.bigGroup === group",
      "value": 0.82
     },
     "value": 0.08
    },
    "order": {
     "field": "subsM",
     "sort": "descending"
    },
    "tooltip": [
     {
      "field": "country",
      "title": "Country"
     },
     {
      "field": "subsM",
      "title": "Mobile subscriptions (millions)",
      "format": ",.1f"
     },
     {
      "field": "subsPer100",
      "title": "Subscriptions per 100 people",
      "format": ".0f"
     },
     {
      "field": "subsYear",
      "title": "Year"
     },
     {
      "field": "apple",
      "title": "Apple share (%)",
      "format": ".1f"
     },
     {
      "field": "samsung",
      "title": "Samsung share (%)",
      "format": ".1f"
     },
     {
      "field": "chinese",
      "title": "Chinese brands share (%)",
      "format": ".1f"
     },
     {
      "field": "transsion",
      "title": "Transsion share (%)",
      "format": ".1f"
     }
    ]
   }
  },
  {
   "data": {
    "values": [
     {
      "lon": 104,
      "lat": 35,
      "tlon": 128,
      "tlat": 58,
      "label": "China: 1.9 billion subscriptions"
     },
     {
      "lon": 78,
      "lat": 22,
      "tlon": 70,
      "tlat": -5,
      "label": "India: 1.2 billion, led by Chinese brands"
     },
     {
      "lon": 8,
      "lat": 9,
      "tlon": -14,
      "tlat": -12,
      "label": "Nigeria: Transsion's home ground"
     },
     {
      "lon": 134,
      "lat": -25,
      "tlon": 100,
      "tlat": -38,
      "label": "Australia: 30 million, Apple-led"
     }
    ]
   },
   "layer": [
    {
     "mark": {
      "type": "rule",
      "color": "#1b1f24",
      "strokeWidth": 0.8
     },
     "encoding": {
      "longitude": {
       "field": "lon",
       "type": "quantitative"
      },
      "latitude": {
       "field": "lat",
       "type": "quantitative"
      },
      "longitude2": {
       "field": "tlon"
      },
      "latitude2": {
       "field": "tlat"
      }
     }
    },
    {
     "mark": {
      "type": "text",
      "fontSize": 11.5,
      "fontWeight": 600,
      "stroke": "#ffffff",
      "strokeWidth": 3.5,
      "strokeJoin": "round",
      "dy": -7
     },
     "encoding": {
      "longitude": {
       "field": "tlon",
       "type": "quantitative"
      },
      "latitude": {
       "field": "tlat",
       "type": "quantitative"
      },
      "text": {
       "field": "label"
      }
     }
    },
    {
     "mark": {
      "type": "text",
      "fontSize": 11.5,
      "fontWeight": 600,
      "color": "#1b1f24",
      "dy": -7
     },
     "encoding": {
      "longitude": {
       "field": "tlon",
       "type": "quantitative"
      },
      "latitude": {
       "field": "tlat",
       "type": "quantitative"
      },
      "text": {
       "field": "label"
      }
     }
    }
   ]
  }
 ]
}