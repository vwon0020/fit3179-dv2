{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "description": "Map 2 - Bivariate choropleth: iPhone share (StatCounter) crossed with GDP per person (World Bank). Hover the 3x3 key to find matching countries.",
 "params": [
  {
   "name": "cell",
   "select": {
    "type": "point",
    "fields": [
     "biv"
    ],
    "on": "mouseover",
    "clear": "mouseout"
   },
   "views": [
    "key"
   ]
  }
 ],
 "hconcat": [
  {
   "width": 715,
   "height": 360,
   "projection": {
    "type": "equalEarth"
   },
   "layer": [
    {
     "data": {
      "sphere": true
     },
     "mark": {
      "type": "geoshape",
      "fill": "#f2f4f5",
      "stroke": "#cfd8de",
      "strokeWidth": 0.6
     }
    },
    {
     "data": {
      "url": "data/countries-110m.json",
      "format": {
       "type": "topojson",
       "feature": "countries"
      }
     },
     "transform": [
      {
       "filter": "datum.id !== '010'"
      }
     ],
     "mark": {
      "type": "geoshape",
      "fill": "#ffffff",
      "stroke": "#cfc9bc",
      "strokeWidth": 0.4,
      "strokeDash": [
       2,
       1
      ]
     },
     "encoding": {
      "tooltip": {
       "value": "No data"
      }
     }
    },
    {
     "data": {
      "url": "data/countries-110m.json",
      "format": {
       "type": "topojson",
       "feature": "countries"
      }
     },
     "transform": [
      {
       "filter": "datum.id !== '010'"
      },
      {
       "lookup": "id",
       "from": {
        "data": {
         "url": "data/world_phones.json"
        },
        "key": "id",
        "fields": [
         "country",
         "apple",
         "gdpPc",
         "gdpYear"
        ]
       }
      },
      {
       "filter": "isValid(datum.apple) && isValid(datum.gdpPc)"
      },
      {
       "calculate": "datum.apple < 25 ? 1 : datum.apple < 45 ? 2 : 3",
       "as": "aClass"
      },
      {
       "calculate": "datum.gdpPc < 10000 ? 1 : datum.gdpPc < 40000 ? 2 : 3",
       "as": "gClass"
      },
      {
       "calculate": "datum.gClass + '-' + datum.aClass",
       "as": "biv"
      }
     ],
     "mark": {
      "type": "geoshape",
      "stroke": "#ffffff",
      "strokeWidth": 0.4
     },
     "encoding": {
      "color": {
       "field": "biv",
       "type": "nominal",
       "legend": null,
       "scale": {
        "domain": [
         "1-1",
         "1-2",
         "1-3",
         "2-1",
         "2-2",
         "2-3",
         "3-1",
         "3-2",
         "3-3"
        ],
        "range": [
         "#e8e8e8",
         "#e4acac",
         "#c85a5a",
         "#b0d5df",
         "#ad9ea5",
         "#985356",
         "#64acbe",
         "#627f8c",
         "#574249"
        ]
       }
      },
      "opacity": {
       "condition": {
        "param": "cell",
        "empty": true,
        "value": 1
       },
       "value": 0.12
      },
      "tooltip": [
       {
        "field": "country",
        "title": "Country"
       },
       {
        "field": "apple",
        "title": "iPhone share of phones (%)",
        "format": ".1f"
       },
       {
        "field": "gdpPc",
        "title": "GDP per person (US$)",
        "format": ",.0f"
       },
       {
        "field": "gdpYear",
        "title": "GDP year"
       }
      ]
     }
    },
    {
     "data": {
      "values": [
       {
        "lon": 138,
        "lat": 36,
        "tlon": 160,
        "tlat": 20,
        "label": "Japan: rich and 61% iPhone"
       },
       {
        "lon": 127.8,
        "lat": 36.5,
        "tlon": 122,
        "tlat": 55,
        "label": "South Korea: rich, yet only 31% iPhone"
       },
       {
        "lon": 134,
        "lat": -25,
        "tlon": 120,
        "tlat": -48,
        "label": "Australia: top-right corner of the key"
       },
       {
        "lon": 20,
        "lat": -1,
        "tlon": 10,
        "tlat": -38,
        "label": "Most of Africa: lower income, few iPhones"
       },
       {
        "lon": 54,
        "lat": 24,
        "tlon": 72,
        "tlat": 40,
        "label": "UAE: rich, yet only 20% iPhone"
       }
      ]
     },
     "layer": [
      {
       "mark": {
        "type": "rule",
        "color": "#1b1f24",
        "strokeWidth": 0.8
       },
       "encoding": {
        "longitude": {
         "field": "lon",
         "type": "quantitative"
        },
        "latitude": {
         "field": "lat",
         "type": "quantitative"
        },
        "longitude2": {
         "field": "tlon"
        },
        "latitude2": {
         "field": "tlat"
        }
       }
      },
      {
       "mark": {
        "type": "circle",
        "size": 22,
        "color": "#ffffff",
        "stroke": "#1b1f24",
        "strokeWidth": 1,
        "opacity": 1
       },
       "encoding": {
        "longitude": {
         "field": "lon",
         "type": "quantitative"
        },
        "latitude": {
         "field": "lat",
         "type": "quantitative"
        }
       }
      },
      {
       "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "stroke": "#ffffff",
        "strokeWidth": 3.5,
        "strokeJoin": "round",
        "dy": -7
       },
       "encoding": {
        "longitude": {
         "field": "tlon",
         "type": "quantitative"
        },
        "latitude": {
         "field": "tlat",
         "type": "quantitative"
        },
        "text": {
         "field": "label"
        }
       }
      },
      {
       "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#1b1f24",
        "dy": -7
       },
       "encoding": {
        "longitude": {
         "field": "tlon",
         "type": "quantitative"
        },
        "latitude": {
         "field": "tlat",
         "type": "quantitative"
        },
        "text": {
         "field": "label"
        }
       }
      }
     ]
    }
   ]
  },
  {
   "name": "key",
   "title": {
    "text": "How to read the colours",
    "subtitle": [
     "Hover a square to find",
     "those countries on the map"
    ],
    "anchor": "start",
    "fontSize": 13
   },
   "width": 132,
   "height": 132,
   "data": {
    "values": [
     {
      "biv": "1-1",
      "a": 1,
      "g": 1
     },
     {
      "biv": "1-2",
      "a": 2,
      "g": 1
     },
     {
      "biv": "1-3",
      "a": 3,
      "g": 1
     },
     {
      "biv": "2-1",
      "a": 1,
      "g": 2
     },
     {
      "biv": "2-2",
      "a": 2,
      "g": 2
     },
     {
      "biv": "2-3",
      "a": 3,
      "g": 2
     },
     {
      "biv": "3-1",
      "a": 1,
      "g": 3
     },
     {
      "biv": "3-2",
      "a": 2,
      "g": 3
     },
     {
      "biv": "3-3",
      "a": 3,
      "g": 3
     }
    ]
   },
   "transform": [
    {
     "calculate": "['under 25%', '25-45%', 'over 45%'][datum.a - 1]",
     "as": "aLabel"
    },
    {
     "calculate": "['under $10k', '$10k-40k', 'over $40k'][datum.g - 1]",
     "as": "gLabel"
    }
   ],
   "mark": {
    "type": "rect",
    "stroke": "#ffffff",
    "strokeWidth": 2,
    "cursor": "pointer"
   },
   "encoding": {
    "x": {
     "field": "aLabel",
     "type": "ordinal",
     "sort": [
      "under 25%",
      "25-45%",
      "over 45%"
     ],
     "title": "iPhone share \u2192",
     "axis": {
      "labelAngle": -40,
      "domain": false,
      "ticks": false
     }
    },
    "y": {
     "field": "gLabel",
     "type": "ordinal",
     "sort": [
      "over $40k",
      "$10k-40k",
      "under $10k"
     ],
     "title": "GDP per person \u2192",
     "axis": {
      "domain": false,
      "ticks": false
     }
    },
    "color": {
     "field": "biv",
     "type": "nominal",
     "legend": null,
     "scale": {
      "domain": [
       "1-1",
       "1-2",
       "1-3",
       "2-1",
       "2-2",
       "2-3",
       "3-1",
       "3-2",
       "3-3"
      ],
      "range": [
       "#e8e8e8",
       "#e4acac",
       "#c85a5a",
       "#b0d5df",
       "#ad9ea5",
       "#985356",
       "#64acbe",
       "#627f8c",
       "#574249"
      ]
     }
    },
    "strokeWidth": {
     "condition": {
      "param": "cell",
      "empty": false,
      "value": 4
     },
     "value": 2
    },
    "tooltip": [
     {
      "field": "aLabel",
      "title": "iPhone share"
     },
     {
      "field": "gLabel",
      "title": "GDP per person (US$)"
     }
    ]
   }
  }
 ],
 "resolve": {
  "scale": {
   "color": "shared"
  }
 }
}